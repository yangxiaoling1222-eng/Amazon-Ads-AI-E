# ============================================
# WorkBuddy 环境变量配置示例
# 复制此文件为 .env 并填入真实值
# 注意：.env 文件已被加入 .gitignore，不会被上传到 GitHub
# ============================================

# ------- 服务器配置 -------
PORT=3000
NODE_ENV=development

# ------- 数据库配置 -------
DATABASE_PATH=./data/ads_platform.db

# ------- 领星 ERP API -------
# 在 https://open.lingxing.com/ 获取
LINGXING_APP_KEY=your_app_key_here
LINGXING_APP_SECRET=your_app_secret_here
LINGXING_TOKEN=your_token_here

# ------- Amazon Ads API -------
# 在 https://advertising.amazon.com/API 获取
AMAZON_CLIENT_ID=your_client_id_here
AMAZON_CLIENT_SECRET=your_client_secret_here
AMAZON_REFRESH_TOKEN=your_refresh_token_here
AMAZON_ADVERTISER_ID=your_advertiser_id_here

# ------- AI 模型配置（OpenRouter）-------
# 在 https://openrouter.ai/ 获取
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-preview

# ------- 其他可选配置 -------
# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# 是否启用演示模式（无真实 API 时）
DEMO_MODE=false
