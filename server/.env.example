# 亚马逊广告AI专家平台 - 环境配置
# 复制此文件为 .env 并填写实际值

# 服务端口
PORT=3000

# ============ 领星ERP API 配置 ============
LINGXING_API_KEY=your_lingxing_api_key_here
LINGXING_API_SECRET=your_lingxing_api_secret_here
LINGXING_API_URL=https://open.lingxing.com/api

# ============ Amazon Ads API 配置 ============
# Amazon Ads API 需要 OAuth2 认证
AMAZON_CLIENT_ID=your_amazon_client_id_here
AMAZON_CLIENT_SECRET=your_amazon_client_secret_here
AMAZON_REFRESH_TOKEN=your_amazon_refresh_token_here
AMAZON_REGION=NA  # NA (北美), EU (欧洲), FE (远东)
AMAZON_SANDBOX=false  # true=测试环境, false=正式环境

# ============ 数据库配置 ============
DATABASE_PATH=./data/ads_platform.db
